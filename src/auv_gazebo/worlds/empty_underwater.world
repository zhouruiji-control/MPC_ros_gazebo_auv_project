<?xml version="1.0" ?>
<sdf version="1.6">

  <world name="empty_underwater">

    <!-- Gazebo状态服务插件 -->
    <plugin
      name="gazebo_ros_state"
      filename="libgazebo_ros_state.so"/>

    <!-- 当前简化模型不启用重力 -->
    <gravity>0 0 0</gravity>

    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- 场景颜色 -->
    <scene>
      <ambient>0.3 0.4 0.6 1</ambient>
      <background>0.05 0.10 0.20 1</background>
    </scene>

    <!-- 光照 -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Gazebo初始摄像机 -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>20 -40 20 0 0.5 2.0</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

    <!-- ==================================================
         蓝色半透明水面
         z = 0
         仅用于视觉显示，没有碰撞和真实水动力
    ================================================== -->
    <model name="water_surface_visual">

      <static>true</static>

      <!-- 整个水面位于世界坐标 z=0 -->
      <pose>0 0 0 0 0 0</pose>

      <link name="water_surface_link">

        <visual name="water_surface_visual">

          <!-- 单层平面，不再使用有厚度的box -->
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>

          <!-- Gazebo自带蓝色透明材质 -->
          <material>
            <script>
              <uri>
                file://media/materials/scripts/gazebo.material
              </uri>
              <name>Gazebo/BlueTransparent</name>
            </script>
          </material>

          <cast_shadows>false</cast_shadows>

        </visual>

        <!--
        不设置collision：
        水面不会挡住AUV运动，也不会产生碰撞力
        -->

      </link>

    </model>

  </world>

</sdf>