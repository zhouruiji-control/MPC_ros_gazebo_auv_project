<?xml version="1.0"?>

<?xml-model
  href="http://download.ros.org/schema/package_format3.xsd"
  schematypens="http://www.w3.org/2001/XMLSchema"?>

<package format="3">

  <name>auv_gazebo</name>

  <version>0.0.0</version>

  <description>
    Gazebo simulation and launch files for the AUV depth control project.
  </description>

  <maintainer email="3620366511@hrbeu.edu.cn">
    ruisupurb
  </maintainer>

  <license>Apache-2.0</license>

  <!-- 构建工具 -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- ROS 2 launch -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <!-- Gazebo -->
  <exec_depend>gazebo_ros</exec_depend>

  <!-- AUV模型加载 -->
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>auv_description</exec_depend>

  <!-- PID、反馈、外力等控制节点 -->
  <exec_depend>auv_lqr_ros</exec_depend>

  <!-- 测试依赖 -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>

</package>